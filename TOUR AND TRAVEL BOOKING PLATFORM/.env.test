# Dummy Firebase config used by Vitest (mode=test).
# Values are never used against a real project; they only keep initializeApp(),
# getAuth(), getFirestore() and getStorage() from throwing during imports.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-tour-travel.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-tour-travel
VITE_FIREBASE_STORAGE_BUCKET=demo-tour-travel.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
VITE_USE_EMULATORS=false

VITE_LOCATION_API_KEY=
VITE_WEATHER_API_KEY=
