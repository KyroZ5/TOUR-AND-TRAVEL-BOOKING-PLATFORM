# Firebase Emulator Suite configuration (mode=emulator).
# The "demo-" project prefix makes the emulators run fully offline - no real
# Firebase project or credentials are required.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-tour-travel.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-tour-travel
VITE_FIREBASE_STORAGE_BUCKET=demo-tour-travel.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo

# Connects the app to the local emulators instead of production Firebase.
VITE_USE_EMULATORS=true

# Optional - leave blank to exercise the "not configured" UI states.
VITE_LOCATION_API_KEY=
VITE_WEATHER_API_KEY=
