{
  "name": "tour-and-travel-booking-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emu": "vite --mode emulator",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "emulators": "firebase emulators:start --only auth,firestore,storage --project demo-tour-travel",
    "seed:emu": "node scripts/seed-emulator.mjs",
    "test:rules": "firebase emulators:exec --only firestore,auth,storage --project demo-tour-travel \"vitest run --config vitest.emulator.config.js --mode emulator tests/rules\"",
    "test:integration": "firebase emulators:exec --only firestore,auth --project demo-tour-travel \"vitest run --config vitest.emulator.config.js --mode emulator tests/integration\""
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^5.16.7",
    "@mui/material": "^5.16.7",
    "firebase": "^10.14.1",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/coverage-v8": "^3.2.7",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^14.27.0",
    "jsdom": "^30.1.2",
    "vite": "^5.4.8",
    "vitest": "^3.2.7"
  }
}
